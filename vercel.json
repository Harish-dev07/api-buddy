{
  "version": 2,
  "builds": [
    { "src": "dist/**", "use": "@vercel/static" }
  ],
  "cleanUrls": true,
  "trailingSlash": false,

  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],

  "redirects": [
    { "source": "/old-path", "destination": "/new-path", "permanent": true }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Custom-Header", "value": "my-value" }
      ]
    }
  ]
}
